{
	"info": {
		"name": "domingoscaldas-api (BJJ School)",
		"description": "Testes da API REST do projeto da disciplina Desenvolvimento de aplicações Java com Spring Boot. Base URL: {{baseUrl}} (padrão http://localhost:8080). Rode a aplicação com ./mvnw spring-boot:run — o ProjectRunner já carrega dados de demonstração.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" }
	],
	"item": [
		{
			"name": "Alunos",
			"item": [
				{ "name": "obterLista", "request": { "method": "GET", "url": "{{baseUrl}}/alunos" } },
				{ "name": "obterPorId", "request": { "method": "GET", "url": "{{baseUrl}}/alunos/1" } },
				{ "name": "obterPorId - inexistente (404)", "request": { "method": "GET", "url": "{{baseUrl}}/alunos/999" } },
				{ "name": "obterPorNome (?nome=)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/alunos?nome=sou", "host": ["{{baseUrl}}"], "path": ["alunos"], "query": [{ "key": "nome", "value": "sou" }] } } },
				{ "name": "obterPorFaixa (?faixa=)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/alunos?faixa=AZUL", "host": ["{{baseUrl}}"], "path": ["alunos"], "query": [{ "key": "faixa", "value": "AZUL" }] } } },
				{ "name": "obterAtivos (?ativos=true)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/alunos?ativos=true", "host": ["{{baseUrl}}"], "path": ["alunos"], "query": [{ "key": "ativos", "value": "true" }] } } },
				{ "name": "obterAptosParaGraduacao (?aptosGraduacao=true)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/alunos?aptosGraduacao=true", "host": ["{{baseUrl}}"], "path": ["alunos"], "query": [{ "key": "aptosGraduacao", "value": "true" }] } } },
				{ "name": "ordenarPorFrequencia (?ordenarPor=frequencia)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/alunos?ordenarPor=frequencia", "host": ["{{baseUrl}}"], "path": ["alunos"], "query": [{ "key": "ordenarPor", "value": "frequencia" }] } } },
				{ "name": "obterPontosGraduacao", "request": { "method": "GET", "url": "{{baseUrl}}/alunos/1/pontos-graduacao" } },
				{
					"name": "incluir (201)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"id\": 10,\n  \"nome\": \"Diego Ramos\",\n  \"email\": \"diego@gmail.com\",\n  \"telefone\": \"(21) 95555-0005\",\n  \"dataNascimento\": \"1999-01-30\",\n  \"dataMatricula\": \"2026-08-01\",\n  \"peso\": 77.0,\n  \"ativo\": true,\n  \"faixa\": \"BRANCA\",\n  \"graus\": 0\n}" },
						"url": "{{baseUrl}}/alunos"
					}
				},
				{
					"name": "incluir - id duplicado (409)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"id\": 1,\n  \"nome\": \"Outro Anderson\",\n  \"email\": \"outro@gmail.com\",\n  \"telefone\": \"(21) 90000-0000\",\n  \"faixa\": \"BRANCA\"\n}" },
						"url": "{{baseUrl}}/alunos"
					}
				},
				{
					"name": "incluir - sem id (400)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"nome\": \"Sem Identificador\"\n}" },
						"url": "{{baseUrl}}/alunos"
					}
				},
				{
					"name": "alterar (200)",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"nome\": \"Diego Ramos\",\n  \"email\": \"diego@gmail.com\",\n  \"telefone\": \"(21) 94444-0006\",\n  \"dataNascimento\": \"1999-01-30\",\n  \"dataMatricula\": \"2026-08-01\",\n  \"peso\": 78.0,\n  \"ativo\": true,\n  \"faixa\": \"BRANCA\",\n  \"graus\": 1\n}" },
						"url": "{{baseUrl}}/alunos/10"
					}
				},
				{ "name": "excluir (204)", "request": { "method": "DELETE", "url": "{{baseUrl}}/alunos/10" } },
				{
					"name": "Sub-recursos do aluno",
					"item": [
						{ "name": "obterPresencas", "request": { "method": "GET", "url": "{{baseUrl}}/alunos/1/presencas" } },
						{
							"name": "registrarPresenca (201)",
							"request": {
								"method": "POST",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": { "mode": "raw", "raw": "{\n  \"id\": 500,\n  \"data\": \"2026-08-17\",\n  \"tipoTreino\": \"Gi\"\n}" },
								"url": "{{baseUrl}}/alunos/2/presencas"
							}
						},
						{ "name": "obterConquistas", "request": { "method": "GET", "url": "{{baseUrl}}/alunos/1/conquistas" } },
						{
							"name": "registrarConquista (201) ?campeonatoId=1",
							"request": {
								"method": "POST",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": { "mode": "raw", "raw": "{\n  \"id\": 50,\n  \"categoria\": \"Adulto Azul Medio\",\n  \"medalha\": \"BRONZE\"\n}" },
								"url": { "raw": "{{baseUrl}}/alunos/2/conquistas?campeonatoId=1", "host": ["{{baseUrl}}"], "path": ["alunos", "2", "conquistas"], "query": [{ "key": "campeonatoId", "value": "1" }] }
							}
						},
						{ "name": "obterGraduacoes", "request": { "method": "GET", "url": "{{baseUrl}}/alunos/2/graduacoes" } },
						{
							"name": "registrarGraduacao (201) - atualiza faixa/graus do aluno",
							"request": {
								"method": "POST",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": { "mode": "raw", "raw": "{\n  \"id\": 30,\n  \"faixa\": \"AZUL\",\n  \"grau\": 1,\n  \"data\": \"2026-08-17\"\n}" },
								"url": "{{baseUrl}}/alunos/2/graduacoes"
							}
						}
					]
				}
			]
		},
